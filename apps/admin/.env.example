# HEFTOR admin — environment template. Copy to `.env.local` and fill in the
# blanks. Never commit `.env.local`.

# The MongoDB the main app uses. The admin reads + writes the same database.
MONGODB_URI=mongodb+srv://...

# Credentials for the admin sign-in form. There is no user table — these two
# strings ARE the auth. Pick something long and unique.
ADMIN_USERNAME=tamas
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# HMAC secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_JWT_SECRET=replace-with-32-byte-hex-secret
